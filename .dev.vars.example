# 本地开发用密钥（不要提交到仓库）。复制为 .dev.vars 后填写真实值。
# wrangler dev 会自动读取 .dev.vars；生产环境用 `wrangler secret put`。

SESSION_SECRET=replace-with-a-long-random-string-min-32-chars
# 通用推送 webhook（按 host 自动适配 ntfy / PushPlus / Server酱）。
#   ntfy:      https://ntfy.sh/你的话题
#   PushPlus:  https://www.pushplus.plus/send?token=你的token
#   Server酱:  https://sctapi.ftqq.com/SCT你的token.send
NOTIFY_WEBHOOK_URL=https://www.pushplus.plus/send?token=replace-me

# 仅在启用 Workers AI 时使用（MVP1 默认关闭）
# AI_ENABLED=false
